{
  "name": "speleologie",
  "version": "0.1.0",
  "private": true,
  "description": "Jeu quotidien en pixel art : creuse jusqu'au noyau de la Terre en donnant les réponses les plus improbables.",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "themes:check": "node --disable-warning=ExperimentalWarning scripts/check-themes.js",
    "answers:report": "node --disable-warning=ExperimentalWarning scripts/answers-report.js",
    "backup:check": "node --disable-warning=ExperimentalWarning scripts/backup-check.js",
    "password:reset": "node --disable-warning=ExperimentalWarning scripts/reset-password.js"
  }
}
